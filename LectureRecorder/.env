# ── Mobile app build-time configuration ──────────────────────────────────────
# EXPO_PUBLIC_* variables are safe to embed: they are not secrets.
# EXPO_PUBLIC_APP_SECRET ships inside the bundle (unavoidable for a shared app
# key), but keeping it here - and out of git - stops the repo from leaking it.
# Set the same value in Render (APP_SECRET) and as an EAS secret for builds.
EXPO_PUBLIC_APP_SECRET=

# Production backend URL (used as the default for fresh installs).
# Override this per-environment by editing this file before building.
EXPO_PUBLIC_BACKEND_URL=https://lecture-api-744h.onrender.com
